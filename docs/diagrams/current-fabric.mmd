%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, Segoe UI, sans-serif", "primaryTextColor": "#0f172a", "lineColor": "#475569"}, "flowchart": {"curve": "basis", "nodeSpacing": 45, "rankSpacing": 65}}}%%
flowchart TB
    accTitle: Conceptual heterogeneous compute fabric
    accDescr: A work request enters the development and control node, which selects one eligible node role. Nodes exchange immutable commits and artifacts, and the private implementation plane supplies operational assignments and evidence.

    Request["Work request<br/>capabilities + acceptance criteria"] --> Dev

    subgraph Fabric["Heterogeneous compute fabric"]
        direction LR
        Dev["dev-N<br/>develop · plan · coordinate"]
        Match{"Select one eligible<br/>archetype and Node Slot"}
        Compute["compute-N<br/>CPU · memory · accelerator"]
        Cloud["cloud-N<br/>remote · elastic · architecture-specific"]
        Deploy["deploy-N<br/>services · data · staging"]
        Dev --> Match
        Match -- interactive --> Dev
        Match -- bounded compute --> Compute
        Match -- remote capacity --> Cloud
        Match -- service or data --> Deploy
    end

    Commits[("Immutable commits")]
    Artifacts[("Immutable artifacts")]
    Release["Reviewed release input"]

    Dev <--> Commits
    Compute <--> Commits
    Cloud <--> Commits
    Dev --> Artifacts
    Compute --> Artifacts
    Cloud --> Artifacts
    Commits --> Release
    Artifacts --> Release
    Release --> Deploy

    Private["Private implementation plane<br/>assignments · access · configuration<br/>evidence · automation"]
    Private -. "implements and operates" .-> Fabric

    classDef control fill:#eff6ff,stroke:#2563eb,color:#1e3a8a,stroke-width:2px;
    classDef node fill:#ecfdf5,stroke:#059669,color:#064e3b,stroke-width:2px;
    classDef private fill:#f5f3ff,stroke:#7c3aed,color:#4c1d95,stroke-width:2px,stroke-dasharray:5 4;
    class Request,Match,Commits,Artifacts,Release control;
    class Dev,Compute,Cloud,Deploy node;
    class Private private;
