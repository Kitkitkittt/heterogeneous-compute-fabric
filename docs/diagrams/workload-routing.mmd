%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Inter, Segoe UI, sans-serif", "primaryTextColor": "#0f172a", "lineColor": "#475569"}, "flowchart": {"curve": "basis", "nodeSpacing": 40, "rankSpacing": 55}}}%%
flowchart TB
    accTitle: Conceptual workload routing
    accDescr: A declared workload selects a matching node archetype, then passes compatibility, admission, capacity, and policy gates before execution. Results are reviewed, while deployment additionally requires immutable release, health, and rollback gates.

    Task["Work request"] --> Contract{"Capabilities and<br/>acceptance criteria declared?"}
    Contract -- no --> ContractBlocked["Do not schedule<br/>complete the contract"]
    Contract -- yes --> Kind{"Required workload class"}

    Kind -- interactive --> Dev["Development / control candidate"]
    Kind -- CPU, memory, accelerator --> Compute["Compute candidate"]
    Kind -- remote or architecture-specific --> Cloud["Cloud candidate"]
    Kind -- service, data, storage --> Deploy["Deployment / data candidate"]

    Dev --> Admission
    Compute --> Admission
    Cloud --> Admission
    Deploy --> Admission
    Admission{"Selected candidate passes<br/>compatibility, admission,<br/>capacity, and policy?"}
    Admission -- no --> CandidateBlocked["Do not schedule<br/>select another candidate or satisfy gates"]
    Admission -- yes --> Execute["Execute from versioned source<br/>or immutable input"]
    Execute --> Result["Immutable result + evidence"]
    Result --> Acceptance{"Acceptance criteria pass?"}
    Acceptance -- no --> Rework["Record failure<br/>revise or retry"]
    Acceptance -- yes --> Deployment{"Deployment requested?"}
    Deployment -- no --> Publish["Publish accepted result"]
    Deployment -- yes --> Release{"Reviewed immutable release,<br/>health, and rollback gates pass?"}
    Release -- no --> DeployBlocked["Do not deploy<br/>satisfy release gates"]
    Release -- yes --> DeployAction["Deployment / data role<br/>consumes release input"]
    DeployAction --> Publish

    classDef decision fill:#f8fafc,stroke:#475569,color:#0f172a,stroke-width:2px;
    classDef blocked fill:#fef2f2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px;
    classDef node fill:#eff6ff,stroke:#2563eb,color:#1e3a8a,stroke-width:2px;
    classDef evidence fill:#ecfdf5,stroke:#059669,color:#064e3b,stroke-width:2px;
    class Contract,Kind,Admission,Acceptance,Deployment,Release decision;
    class ContractBlocked,CandidateBlocked,DeployBlocked,Rework blocked;
    class Dev,Compute,Cloud,Deploy node;
    class Execute,Result,DeployAction,Publish evidence;
